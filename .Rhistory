# fit segmented + lm for every stock, keep the pieces needed for plotting
fits <- map(sort(unique(df$stock)), function(s) {
temp <- df %>% filter(stock == s)
m    <- lm(prod.rate ~ biomass, data = temp)
sm   <- try(segmented(m, seg.Z = ~ biomass), silent = TRUE)
if (inherits(sm, "try-error") || is.null(sm$psi)) return(NULL)
b1 <- as.numeric(coef(sm)[2])
list(stock  = s, data = temp, mod = sm, psi = as.numeric(sm$psi[2]),
slope1 = b1, slope2 = b1 + as.numeric(coef(sm)[3]),
lm_AIC = AIC(m), seg_AIC = AIC(sm))
}) %>% compact()
# depensatory shape (+ then -) and segmented favoured by AIC
sel <- fits %>% keep(~ .x$slope1 > 0 & .x$slope2 < 0 & .x$seg_AIC < .x$lm_AIC)
# segmented fit, plus the post-breakpoint slope extrapolated below psi
pred <- map_dfr(sel, function(f) {
b   <- seq(min(f$data$biomass), max(f$data$biomass), length.out = 200)
psi <- f$psi
tibble(
stock   = f$stock,
biomass = b,
`Segmented fit`  = predict(f$mod, data.frame(biomass = b)),
`No depensation` = ifelse(b <= psi,
predict(f$mod, data.frame(biomass = psi)) + f$slope2 * (b - psi),
NA_real_)
) %>%
pivot_longer(-c(stock, biomass), names_to = "line", values_to = "prod.rate") %>%
drop_na(prod.rate)
})
pts <- map_dfr(sel, "data")
brk <- map_dfr(sel, ~ tibble(stock = .x$stock, psi = .x$psi))
# figure: observed points, continuous segmented fit, counterfactual extrapolation
ggplot(pts, aes(biomass, prod.rate)) +
geom_hline(yintercept = 0, colour = "grey80", linewidth = 0.3) +
geom_point(colour = "grey40", alpha = 0.6, size = 1.6) +
geom_vline(data = brk, aes(xintercept = psi), linetype = "dotted", colour = "grey50") +
geom_line(data = pred, aes(colour = line, linetype = line), linewidth = 0.9) +
facet_wrap(~ stock, scales = "free_y") +
scale_colour_manual(values = c("Segmented fit" = "black", "No depensation" = "firebrick")) +
scale_linetype_manual(values = c("Segmented fit" = "solid", "No depensation" = "dashed")) +
labs(x = "Biomass (scaled to stock maximum)",
y = "Relative surplus production",
colour = NULL, linetype = NULL) +
theme_minimal(base_size = 11) +
theme(legend.position = "bottom", strip.text = element_text(face = "bold"))
# fit segmented + lm per stock
fits <- map(sort(unique(df$stock)), function(s) {
temp <- df %>% filter(stock == s)
m    <- lm(prod.rate ~ biomass, data = temp)
sm   <- try(segmented(m, seg.Z = ~ biomass), silent = TRUE)
if (inherits(sm, "try-error") || is.null(sm$psi)) return(NULL)
b1 <- as.numeric(coef(sm)[2])
list(stock  = s, data = temp, mod = sm, psi = as.numeric(sm$psi[2]),
slope1 = b1, slope2 = b1 + as.numeric(coef(sm)[3]),
lm_AIC = AIC(m), seg_AIC = AIC(sm))
}) %>% compact()
# keep depensatory stocks (+ before, - after) where segmented beats lm
sel <- fits %>% keep(~ .x$slope1 > 0 & .x$slope2 < 0 & .x$seg_AIC < .x$lm_AIC)
# observations
df_plot <- map_dfr(sel, function(f) {
f$data %>% mutate(psi = f$psi,
segment = if_else(biomass < f$psi, "before_break", "after_break"))
})
# continuous segmented fit, split at psi for colouring
df_seg <- map_dfr(sel, function(f) {
b1 <- c(seq(min(f$data$biomass), f$psi, length.out = 100))
b2 <- c(seq(f$psi, max(f$data$biomass), length.out = 100))
bind_rows(tibble(biomass = b1, segment = "before_break"),
tibble(biomass = b2, segment = "after_break")) %>%
mutate(stock = f$stock,
prod.rate = predict(f$mod, data.frame(biomass = biomass)))
})
# post-break slope extrapolated below psi
df_pred_lm_before <- map_dfr(sel, function(f) {
b <- seq(min(f$data$biomass), f$psi, length.out = 100)
tibble(stock = f$stock, biomass = b,
pred_lm_after = predict(f$mod, data.frame(biomass = f$psi)) + f$slope2 * (b - f$psi))
})
ggplot(df_plot, aes(x = biomass, y = prod.rate)) +
geom_point(size = 1, alpha = 0.7) +
geom_line(alpha = 0.4) +
# vertical psi line
geom_vline(aes(xintercept = psi),
colour = "grey",
linetype = "dashed",
linewidth = 0.8) +
# continuous segmented fit, coloured by segment
geom_line(
data = df_seg,
aes(colour = segment),
linewidth = 1
) +
# dashed extrapolation of post-break slope into pre-break biomass
geom_line(
data = df_pred_lm_before,
aes(x = biomass, y = pred_lm_after),
linetype = "dashed",
linewidth = 1,
colour = "coral"
) +
library(tidyverse)
library(segmented)
# fit segmented + lm per stock
fits <- map(sort(unique(df$stock)), function(s) {
temp <- df %>% filter(stock == s)
m    <- lm(prod.rate ~ biomass, data = temp)
sm   <- try(segmented(m, seg.Z = ~ biomass), silent = TRUE)
if (inherits(sm, "try-error") || is.null(sm$psi)) return(NULL)
b1 <- as.numeric(coef(sm)[2])
list(stock  = s, data = temp, mod = sm, psi = as.numeric(sm$psi[2]),
slope1 = b1, slope2 = b1 + as.numeric(coef(sm)[3]),
lm_AIC = AIC(m), seg_AIC = AIC(sm))
}) %>% compact()
# keep depensatory stocks (+ before, - after) where segmented beats lm
sel <- fits %>% keep(~ .x$slope1 > 0 & .x$slope2 < 0 & .x$seg_AIC < .x$lm_AIC)
# observations
df_plot <- map_dfr(sel, function(f) {
f$data %>% mutate(psi = f$psi,
segment = if_else(biomass < f$psi, "before_break", "after_break"))
})
# continuous segmented fit, split at psi for colouring
df_seg <- map_dfr(sel, function(f) {
b1 <- c(seq(min(f$data$biomass), f$psi, length.out = 100))
b2 <- c(seq(f$psi, max(f$data$biomass), length.out = 100))
bind_rows(tibble(biomass = b1, segment = "before_break"),
tibble(biomass = b2, segment = "after_break")) %>%
mutate(stock = f$stock,
prod.rate = predict(f$mod, data.frame(biomass = biomass)))
})
# post-break slope extrapolated below psi
df_pred_lm_before <- map_dfr(sel, function(f) {
b <- seq(min(f$data$biomass), f$psi, length.out = 100)
tibble(stock = f$stock, biomass = b,
pred_lm_after = predict(f$mod, data.frame(biomass = f$psi)) + f$slope2 * (b - f$psi))
})
ggplot(df_plot, aes(x = biomass, y = prod.rate)) +
geom_point(size = 1, alpha = 0.7) +
geom_line(alpha = 0.4) +
# vertical psi line
geom_vline(aes(xintercept = psi),
colour = "grey",
linetype = "dashed",
linewidth = 0.8) +
# continuous segmented fit, coloured by segment
geom_line(
data = df_seg,
aes(colour = segment),
linewidth = 1
) +
# dashed extrapolation of post-break slope into pre-break biomass
geom_line(
data = df_pred_lm_before,
aes(x = biomass, y = pred_lm_after),
linetype = "dashed",
linewidth = 1,
colour = "coral"
) +
geom_hline(aes(yintercept = 0),
linetype = "dashed",
colour = "grey",
linewidth = 0.8) +
facet_wrap(~ stock, ncol = 4) +
scale_x_continuous(
breaks = c(0, 0.25, 0.5, 0.75, 1),
limits = c(0, 1),
labels = c("0", "0.25", "0.50", "0.75", "1")
) +
theme_bw() +
theme(legend.position = "none",
axis.text.x = element_text(size = 6)) +
labs(
x = "Biomass (proportion of maximum)",
y = "Relative surplus production",
color = "Segment"
)
