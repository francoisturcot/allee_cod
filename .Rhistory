temp = df %>% filter(stock == s)
#lm
model = lm(prod.rate~biomass, data = temp)
depensatory_lm = coefficients(model)[2]>0
depensatory_lm
#segmented
segmented <- segmented(model, seg.Z = ~biomass)
#save segmented regression breakpoint (phi)
psi = segmented$psi[2]
#save AIC
t1 = AIC(model, segmented)
t1$model = rownames(t1)
m_AIC = t1 %>% filter(model == "model")
s_AIC = t1 %>% filter(model == "segmented")
t1
# Add a column to indicate which segment each row belongs to
temp <- temp %>%
mutate(segment = case_when(
biomass < psi ~ "before_break",
biomass >= psi ~ "after_break"
))
# Fit linear regressions before and after the break
m1 <- lm(prod.rate ~ biomass, data = temp %>% filter(segment == "before_break"))
m2 <- lm(prod.rate ~ biomass, data = temp %>% filter(segment == "after_break"))
depensatory_seg = coefficients(m1)[2]>0
# Fit segmented regression with continuity
model <- lm(prod.rate ~ biomass, data = temp)
segmented_model <- segmented(model, seg.Z = ~ biomass)
psi <- segmented_model$psi[2]
# Extract slopes from segmented model
slope_low <- coef(segmented_model)[2]
slope_change <- coef(segmented_model)[3]
slope_high <- slope_low + slope_change
# Get prediction at breakpoint (where both segments meet)
pred_at_psi <- predict(segmented_model, data.frame(biomass = psi))
# Predict at minimum biomass using the high biomass regression extrapolated
# This represents production if no depensation occurred
pr_high_extrapolated <- pred_at_psi + slope_high * (min(temp$biomass) - psi)
# Fit regression for low biomass segment (shows actual depensation)
m1 <- lm(prod.rate ~ biomass, data = temp %>% filter(biomass < psi))
pr_low_observed <- predict(m1, data.frame(biomass = min(temp$biomass)))
# Allee effect strength (proportional loss relative to normal production)
As <- (pr_high_extrapolated - pr_low_observed) / pr_high_extrapolated
# Production rate at minimum biomass (observed with Allee effect)
delta_0 <- pr_low_observed
library(tidyverse)
library(segmented)
# Example plot function for a single stock (adapt for loop or facets)
plot_segmented_allee <- function(temp, stock_name) {
# Fit models
model <- lm(prod.rate ~ biomass, data = temp)
segmented_model <- segmented(model, seg.Z = ~ biomass)
psi <- segmented_model$psi[2]
# Extract slopes
slope_low <- coef(segmented_model)[2]
slope_high <- slope_low + coef(segmented_model)[3]
pred_at_psi <- predict(segmented_model, data.frame(biomass = psi))
# Predictions for plotting
biomass_seq <- seq(min(temp$biomass), max(temp$biomass), length.out = 100)
# Segmented regression line
seg_pred <- predict(segmented_model, data.frame(biomass = biomass_seq))
# High biomass regression extrapolated
high_extrap <- pred_at_psi + slope_high * (biomass_seq - psi)
# Create data frame for lines
lines_df <- data.frame(
biomass = biomass_seq,
segmented = seg_pred,
high_extrapolated = high_extrap
) %>%
pivot_longer(cols = -biomass, names_to = "model", values_to = "pred_rate")
# Plot
p <- ggplot(temp, aes(x = biomass, y = prod.rate)) +
geom_point(aes(color = ifelse(biomass < psi, "Low biomass", "High biomass")),
size = 3, alpha = 0.6) +
geom_line(data = lines_df %>% filter(model == "segmented"),
aes(y = pred_rate), color = "black", linewidth = 1) +
geom_line(data = lines_df %>% filter(model == "high_extrapolated"),
aes(y = pred_rate), color = "red", linewidth = 1, linetype = "dashed",
label = "High biomass regression\n(no Allee effect)") +
geom_vline(xintercept = psi, linetype = "dotted", color = "gray50", alpha = 0.7) +
labs(
title = stock_name,
x = "Biomass (scaled)",
y = "Production rate",
color = "Segment"
) +
theme_minimal() +
theme(
legend.position = "bottom",
plot.title = element_text(hjust = 0.5, face = "bold")
)
return(p)
}
# Example: plot first stock
s <- stock[1]
temp <- df %>% filter(stock == s)
plot_segmented_allee(temp, s)
# For all stocks (faceted):
# Create list of plots for multiple stocks
plot_list <- lapply(stock[1:6], function(s) {  # First 6 stocks as example
temp <- df %>% filter(stock == s)
plot_segmented_allee(temp, s) +
theme(legend.position = "none")
})
# Combine plots
gridExtra::grid.arrange(grobs = plot_list, ncol = 3)
