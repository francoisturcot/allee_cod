vjust = 1.2,
size = 8,
colour = "red"
)+
facet_wrap(~ stock) +
theme_bw() +
scale_x_continuous(
breaks = c(0, 0.25, 0.5, 0.75, 1),
limits = c(0, 1),
labels = c("0", "0.25", "0.50", "0.75", "1")
) +
theme(
legend.position = "none",
axis.text.x = element_text(size = 6)
) +
labs(
x = "Biomass (proportion of maximum)",
y = "Relative surplus production"
)
})
